# Notion integration token (Internal Integration Token)
NOTION_TOKEN=secret_xxx

# Notion DB ID for Search Queries database
NOTION_SEARCH_QUERIES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion DB ID for News Results database
NOTION_NEWS_RESULTS_DB_ID=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# OpenAI API key
OPENAI_API_KEY=sk-xxxx

# OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# HTTP timeout seconds for external APIs (optional)
REQUEST_TIMEOUT_SEC=20

# SMTP server host
SMTP_HOST=smtp.example.com

# SMTP server port (STARTTLS)
SMTP_PORT=587

# SMTP login user
SMTP_USER=mailer@example.com

# SMTP login password or app password
SMTP_PASSWORD=change_me

# Mail sender address
MAIL_FROM=mailer@example.com

# Mail recipients (comma separated)
MAIL_TO=person1@example.com,person2@example.com
